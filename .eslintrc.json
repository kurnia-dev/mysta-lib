{
  "root": true,
  "globals": {
    "NodeJS": true
  },
  "extends": ["ts-code-standard"],
  "overrides": [
    {
      "files": [
        "cypress/e2e /**/*.{cy,spec}.{js,ts,jsx,tsx}",
        "cypress/support /**/*.{js,ts,jsx,tsx}"
      ],
      "extends": ["plugin:cypress/recommended"]
    },
    {
      "files": ["*.d.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "complexity": ["error", 50],
    "@typescript-eslint/no-explicit-any": "off",
    "eqeqeq": "off",
    "no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ]
  },
  "ignorePatterns": ["**/*.js"]
}
