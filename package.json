{
  "name": "mysta-lib",
  "version": "1.0.0",
  "author": "Mystaline",
  "description": "Front End Developer Monorepo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "build": "rimraf dist && pnpm build:presets && vite build",
    "build:dev": "vite build --watch",
    "build:commons": "pnpm --filter mysta-lib build",
    "build:pack": "sh ./scripts/build.sh",
    "build:lib": "pnpm build:commons && pnpm --filter mysta-lib build",
    "release": "sh ./scripts/release-stable.sh",
    "release:alpha": "sh ./scripts/release-alpha.sh",
    "dev:presets": "pnpm --filter react-presets dev",
    "build:presets": "pnpm --filter react-presets build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "serve:http": "sh ./scripts/serve.sh"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "axios": "1.7.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "faker": "^6.6.6",
    "lodash": "4.17.21",
    "pnpm": "^9.9.0",
    "postcss": "8.4.41",
    "postcss-nested": "6.2.0",
    "prettier": "3.3.3",
    "primereact": "^10.9.1",
    "react-icons": "^5.2.1",
    "rimraf": "5.0.10",
    "rollup-plugin-typescript2": "0.36.0",
    "serve": "^14.2.4",
    "single-spa": "6.0.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "uuid": "9.0.1",
    "vite": "5.4.0",
    "vite-plugin-dts": "4.0.2"
  }
}
