{
  "name": "@mystaline/mysta-lib-monorepo",
  "version": "1.0.0",
  "author": "Mystaline",
  "description": "Front End Developer Monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.js",
    "build": "rimraf dist && pnpm -r build && node ./scripts/build-playground.js",
    "build:dev": "vite build --watch",
    "build:commons": "pnpm --filter @mystaline/mysta-commons build",
    "build:lib": "pnpm build:commons && pnpm --filter @mystaline/mysta-lib build",
    "release": "node ./scripts/release.js stable",
    "release:alpha": "node ./scripts/release.js alpha",
    "dev:presets": "pnpm --filter @mystaline/mysta-presets dev",
    "build:presets": "pnpm --filter @mystaline/mysta-presets build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "serve:http": "node ./scripts/serve.js",
    "sync:presets": "node ./scripts/sync-presets.js",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@mystaline/eslint-plugin-mysta-code-standard": "^1.0.10",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "nanoid": "^5.1.5",
    "radix-ui": "^1.3.4",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/blocks": "^8",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.66",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "axios": "1.8.4",
    "eslint": "^9.26.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "lodash": "4.17.21",
    "postcss": "8.4.41",
    "postcss-nested": "6.2.0",
    "prettier": "3.3.3",
    "react-icons": "^5.2.1",
    "rimraf": "5.0.10",
    "rollup-plugin-typescript2": "0.36.0",
    "serve": "^14.2.4",
    "single-spa": "6.0.1",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.31.1",
    "uuid": "9.0.1",
    "vite": "5.4.19",
    "vite-plugin-dts": "4.0.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "axios": "1.14.0"
    }
  }
}
