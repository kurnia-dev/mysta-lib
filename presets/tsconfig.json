{
  "compilerOptions": {
    "allowJs": true,
    "outDir": "dist",
    "declaration": true,
    "module": "ESNext",
    "target": "ESNext",
    "declarationDir": "dist",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "lib/*": ["../library/*"]
    }
  },
  "include": ["**/*.d.ts", "**/*.ts", "**/*.json", "**/preset/**/*.{js|ts}"],
  "exclude": ["dist"]
}
