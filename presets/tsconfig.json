{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "declaration": true,
    "module": "ESNext",
    "target": "ESNext",
    "declarationDir": "dist",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
  },
  "include": [
    "**/*.d.ts",
    "**/*.ts",
    "**/*.json",
    "**/preset/**/*.{js|ts}"
  ],
  "exclude": [
    "dist"
  ]
}