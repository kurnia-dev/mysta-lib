{
  "name": "@mystaline/mysta-lib",
  "version": "1.0.0-alpha.37",
  "author": "Mystaline",
  "description": "ReactJS Component Library",
  "type": "module",
  "main": "./dist/mysta-lib.es.js",
  "module": "./dist/mysta-lib.es.js",
  "types": "./dist/main.d.ts",
  "repository": "https://github.com/mystaline/mysta-lib",
  "scripts": {
    "build": "rimraf dist && vite build --config ./vite.config.ts",
    "release": "node ../../scripts/publish.js"
  },
  "dependencies": {
    "@mystaline/mysta-commons": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/mysta-lib.es.js"
    },
    "./colors.config.json": "./colors.config.json"
  }
}