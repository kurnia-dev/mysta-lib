{
  "compilerOptions": {
    "allowJs": true,
    "outDir": "dist",
    "declaration": true,
    "module": "ESNext",
    "target": "ESNext",
    "declarationDir": "dist",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "Node",
    "resolveJsonModule": true,
  },
  "include": [
    "**/*.d.ts",
    "**/*.ts",
    "**/*.json",
    "**/preset/**/*.js",
    "**/*.tsx"
  ],
  "exclude": [
    "dist/*.js"
  ]
}